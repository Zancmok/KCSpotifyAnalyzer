kcspotifyanalyzer.duckdns.org:9023 {
    tls {
            dns duckdns {env.DUCKDNS_TOKEN}
        }

    log {
            output stderr
        }

    encode gzip

# Laravel PHP-FPM for /api and /auth
    root * /var/www/public
    php_fastcgi /api/* app:9000
    php_fastcgi /auth/* app:9000

# React static files for everything else
    @static not path /api/* /auth/*
    handle @static {
                       root * /srv/react
                       try_files {path} /index.html
                       file_server
                   }
}
